# Copie para apps/api/.env (desenvolvimento) ou configure no provedor de hospedagem (produção).
# NUNCA versione o arquivo .env real.

NODE_ENV=development
HOST=127.0.0.1
PORT=3333

# Produção: PostgreSQL gerenciado. Ex.: postgres://usuario:senha@host:5432/nexus?sslmode=require
# Desenvolvimento sem instalar Postgres: pglite://./.data/dev  (NÃO usar em produção)
DATABASE_URL=pglite://./.data/dev

# Aplica migrações ao iniciar. Padrão: true fora de produção, false em produção.
# AUTO_MIGRATE=true

# Duração da sessão em horas
SESSION_TTL_HOURS=168

# Defina true quando houver proxy reverso (Caddy/Nginx/PaaS) para o IP real chegar aos logs/rate limit
TRUST_PROXY=false

# Menor intervalo de verificação permitido por site, em segundos (limite do plano)
MIN_CHECK_INTERVAL_SECONDS=60

# Portas extras permitidas em URLs monitoradas (além de 80, 443, 8080, 8443)
# EXTRA_ALLOWED_PORTS=3000,8000

LOG_LEVEL=info

# --- Monitoramento (Fase 2) ---
# true = o monitor roda dentro do processo da API (padrao com pglite, so desenvolvimento).
# Em producao deixe false e rode o monitor como servico separado: npm run monitor:prod
# MONITOR_EMBEDDED=false
MONITOR_TICK_SECONDS=5
MONITOR_CONCURRENCY=10
MONITOR_REGION=local
RETENTION_DAYS=90

# --- Site no GitHub Pages ---
# Origem do site (so esquema+dominio, sem o nome do repositorio). Varias separadas por virgula.
# CORS_ORIGINS=https://SEU-USUARIO.github.io
